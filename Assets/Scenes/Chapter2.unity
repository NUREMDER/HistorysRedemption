      value: CinematicTrigger (2)
      objectReference: {fileID: 0}
    - target: {fileID: 7889513539332358479, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: conversation.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 7889513539332358479, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: conversation.Array.data[0].sentence
      value: Defeating Tesla was no walk in the park, but this electric power...
        I can feel this energy pulsing through my veins.
      objectReference: {fileID: 0}
    - target: {fileID: 7889513539332358479, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: conversation.Array.data[1].sentence
      value: 'What kind of place is this? This region of Araf looks much darker and
        more dangerous than the first one.



'
      objectReference: {fileID: 0}
    - target: {fileID: 7889513539332358479, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: conversation.Array.data[2].sentence
      value: I still don't remember who I am, but this power will bring my past back
        to me. No matter what stands in my way, I will tear right through it.
      objectReference: {fileID: 0}
    - target: {fileID: 7889513539332358479, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: conversation.Array.data[0].speakerName
      value: 'Player:'
      objectReference: {fileID: 0}
    - target: {fileID: 7889513539332358479, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: conversation.Array.data[2].speakerName
