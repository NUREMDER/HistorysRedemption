    - target: {fileID: 820085890485684897, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: m_LocalEulerAnglesHint.z
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 2326332796499230668, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: m_Name
      value: CinematicTrigger (1)
      objectReference: {fileID: 0}
    - target: {fileID: 2326332796499230668, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: m_IsActive
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 7889513539332358479, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: bossToWakeUp
      value: 
      objectReference: {fileID: 899665746}
    - target: {fileID: 7889513539332358479, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: teslaBossToWakeUp
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 7889513539332358479, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: conversation.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 7889513539332358479, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: conversation.Array.data[0].sentence
      value: Look what the tide washed in... Another shadow trying to piece together
        its broken soul. You're wasting your time, stranger.
      objectReference: {fileID: 0}
    - target: {fileID: 7889513539332358479, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: conversation.Array.data[1].sentence
      value: 'I don''t care about this realm, Edison. I''m here for my memories.
        And I know you have the answers.

        (Notices the clusters of light
        around Edison)'
      objectReference: {fileID: 0}
    - target: {fileID: 7889513539332358479, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: conversation.Array.data[2].sentence
      value: Answers? In Araf, the only answer that matters is power. The weak are
        forgotten, and the strong control the narrative. Just like in my previous
        life.
      objectReference: {fileID: 0}
    - target: {fileID: 7889513539332358479, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: conversation.Array.data[3].sentence
      value: You mean the life where you stole your success? Tesla told me what you
        did to him.
      objectReference: {fileID: 0}
    - target: {fileID: 7889513539332358479, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: conversation.Array.data[4].sentence
      value: (Notices the sparks around the player) Wait... That current... Those
        lightning arcs around your shadow body... You took his power?!
      objectReference: {fileID: 0}
    - target: {fileID: 7889513539332358479, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: conversation.Array.data[5].sentence
      value: He gave it to me. To make sure you finally pay for your arrogance. It's
        time to see how bright you burn without your stolen ideas.
      objectReference: {fileID: 0}
    - target: {fileID: 7889513539332358479, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: conversation.Array.data[6].sentence
      value: You think a few stolen sparks can dim my light? I control the current
        of this entire sector! Come then, clone! Let's see if you can survive the
        real shock!
      objectReference: {fileID: 0}
    - target: {fileID: 7889513539332358479, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: conversation.Array.data[7].sentence
      value: You have to beat me before I can trust you. As a reward, I will give
        you electric power.
      objectReference: {fileID: 0}
    - target: {fileID: 7889513539332358479, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: conversation.Array.data[8].sentence
      value: Deal!
      objectReference: {fileID: 0}
    - target: {fileID: 7889513539332358479, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: conversation.Array.data[0].speakerName
      value: 'Thomas Edison:'
      objectReference: {fileID: 0}
    - target: {fileID: 7889513539332358479, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: conversation.Array.data[2].speakerName
      value: 'Thomas Edison:'
      objectReference: {fileID: 0}
    - target: {fileID: 7889513539332358479, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: conversation.Array.data[4].speakerName
      value: 'Thomas Edison:'
      objectReference: {fileID: 0}
    - target: {fileID: 7889513539332358479, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: conversation.Array.data[5].speakerName
      value: '      Player:'
      objectReference: {fileID: 0}
    - target: {fileID: 7889513539332358479, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: conversation.Array.data[6].speakerName
      value: 'Thomas Edison:'
      objectReference: {fileID: 0}
    - target: {fileID: 7889513539332358479, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: conversation.Array.data[7].speakerName
      value: 'Nikola Tesla:'
      objectReference: {fileID: 0}
    - target: {fileID: 7889513539332358479, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: conversation.Array.data[8].speakerName
      value: '      Player:'
      objectReference: {fileID: 0}
