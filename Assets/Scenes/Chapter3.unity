      value: CinematicTrigger (1)
      objectReference: {fileID: 0}
    - target: {fileID: 2326332796499230668, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: m_IsActive
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 7889513539332358479, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: teslaBossToWakeUp
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 7889513539332358479, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: newtonBossToWakeUp
      value: 
      objectReference: {fileID: 1253455047}
    - target: {fileID: 7889513539332358479, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: conversation.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 7889513539332358479, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: conversation.Array.data[0].sentence
      value: "So you\u2019ve come. I\u2019m still amazed you managed to beat Edison
        so easily. What\u2019s this, have you become friends with Tesla?"
      objectReference: {fileID: 0}
    - target: {fileID: 7889513539332358479, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: conversation.Array.data[1].sentence
      value: "I\u2019m not friends with anyone. I just did what had to be done. Now
        it\u2019s your turn, Newton."
      objectReference: {fileID: 0}
    - target: {fileID: 7889513539332358479, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: conversation.Array.data[2].sentence
      value: They were just playing with simple sparks, Shadow. My rules, however,
        are the very foundation of the universe.
      objectReference: {fileID: 0}
    - target: {fileID: 7889513539332358479, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: conversation.Array.data[3].sentence
      value: "Let\u2019s see if you can still stand so tall when gravity is turned
        on its head! Your Knives don't give damage to me! My apples will kill you!!"
      objectReference: {fileID: 0}
    - target: {fileID: 7889513539332358479, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: conversation.Array.data[0].speakerName
      value: 'Isaac Newton:'
      objectReference: {fileID: 0}
    - target: {fileID: 7889513539332358479, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: conversation.Array.data[2].speakerName
      value: 'Isaac Newton:'
      objectReference: {fileID: 0}
    - target: {fileID: 7889513539332358479, guid: 85af0a84af6cafb4489fecb1c0076a00, type: 3}
      propertyPath: conversation.Array.data[3].speakerName
      value: 'Isaac Newton:'
      objectReference: {fileID: 0}
